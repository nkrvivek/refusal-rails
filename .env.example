# Alpaca paper credentials for the hackathon book.
# Create at https://app.alpaca.markets → Paper Trading → API Keys.
# These names are deliberately hackathon-scoped: the agent never reads the
# generic ALPACA_API_KEY_ID pair, so it cannot authenticate as another account.
ALPACA_HACKATHON_API_KEY_ID=your_paper_key_id
ALPACA_HACKATHON_API_SECRET=your_paper_secret

# Paper only. AlpacaRest refuses any other host at construction.
ALPACA_HACKATHON_TRADING_ENDPOINT=https://paper-api.alpaca.markets

# Optional: bound on the whole MCP spawn→initialize→call→teardown round trip.
ALPACA_MCP_TIMEOUT_S=45
